orm:translateY(-6px);box-shadow:0 28px 56px -22px rgba(212,160,37,.35)}\n.plan .badge{position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:#d4a037;color:#0a1d33;font-size:.72rem;font-weight:700;padding:5px 14px;border-radius:999px;letter-spacing:.08em}\n.plan h3{font-size:1.25rem;margin:0 0 4px}\n.plan .sub{color:#5b6b85;font-size:.85rem;margin-bottom:18px}\n.plan .price{font-size:2rem;font-weight:800;color:#0c223d;line-height:1.1}\n.plan .price small{font-size:.85rem;font-weight:500;color:#5b6b85;margin-left:4px}\n.plan .annual{margin-top:6px;font-size:.82rem;color:#b6691a;background:#fff5e6;display:inline-block;padding:3px 10px;border-radius:8px}\n.plan ul{list-style:none;padding:0;margin:20px 0 0;flex:1}\n.plan ul li{font-size:.92rem;padding:9px 0;border-top:1px dashed #e3e8f1;color:#3b4c66;position:relative;padding-left:22px}\n.plan ul li:first-child{border-top:0}\n.plan ul li::before{content:\"◆\";position:absolute;left:0;top:9px;color:#d4a037;font-size:.7rem}\n.plan .cta{display:block;text-align:center;margin-top:22px;padding:12px;border-radius:12px;background:#0e2a47;color:#fff;font-weight:600;font-size:.92rem}\n.plan .cta:hover{background:#16487a;text-decoration:none}\n.plan.featured .cta{background:#d4a037;color:#0a1d33}\n.plan.featured .cta:hover{background:#e4b34e}\n\n/* steps */\n.steps{counter-reset:step;display:grid;grid-template-columns:repeat(4,1fr);gap:18px}\n.step{background:#fff;border-radius:18px;padding:24px;box-shadow:0 14px 32px -22px rgba(14,42,71,.22);position:relative}\n.step::before{counter-increment:step;content:counter(step,decimal-leading-zero);position:absolute;top:14px;right:18px;font-size:1.6rem;font-weight:800;color:#e8efff}\n.step h4{font-size:1rem;margin:0 0 6px;color:#0c223d}\n.step p{font-size:.88rem;color:#5b6b85;margin:0}\n\n/* clients */\n.clients{background:#fff;border-radius:20px;padding:30px;box-shadow:0 16px 36px -24px rgba(14,42,71,.22)}\n.client-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;padding:14px 0;border-bottom:1px dashed #e3e8f1;font-size:.92rem;color:#3b4c66;align-items:center}\n.client-row:last-child{border-bottom:0}\n.client-row .plat{font-weight:600;color:#0c223d}\n.client-row .note{color:#5b6b85}\n.client-row a{font-size:.82rem;padding:5px 12px;border-radius:8px;background:#eef3fb;color:#1b4a78;justify-self:end}\n.client-row .soon{font-size:.72rem;background:#fff5e6;color:#b6691a;padding:3px 9px;border-radius:6px;justify-self:end}\n\n/* FAQ */\n.faq-group{margin-bottom:34px}\n.faq-group h3{color:#0e2a47;margin-bottom:12px;font-size:1.1rem;border-left:4px solid #d4a037;padding-left:12px}\ndetails{background:#fff;border-radius:16px;padding:18px 22px;margin-bottom:10px;box-shadow:0 10px 24px -20px rgba(14,42,71,.22);transition:.2s}\ndetails[open]{box-shadow:0 16px 30px -18px rgba(14,42,71,.28)}\nsummary{cursor:pointer;font-weight:600;color:#0c223d;font-size:.98rem;list-style:none;display:flex;justify-content:space-between;align-items:center}\nsummary::after{content:\"+\";color:#d4a037;font-size:1.4rem;font-weight:400;transition:transform .2s}\ndetails[open] summary::after{transform:rotate(45deg)}\nsummary::-webkit-details-marker{display:none}\ndetails p{margin:14px 0 0;color:#4a5a76;font-size:.92rem}\n\n/* footer */\nfooter{background:#0a1d33;color:#9fb3cf;padding:42px 0 30px;font-size:.85rem}\nfooter .foot{display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;align-items:center}\nfooter a{color:#cfdcef}\n\n@media (max-width:880px){\n.hero{padding:64px 0 48px}\n.hero-grid{grid-template-columns:1fr;gap:28px}\n.grid-3,.grid-2,.grid-4,.plans,.steps{grid-template-columns:1fr}\n.plan.featured{transform:none}\n.client-row{grid-template-columns:1fr 1fr}\n.client-row a,.client-row .soon{justify-self:start}\nsection{padding:54px 0}\n}\n</style><header class=\"hero\">\n<div class=\"wrap\">\n<div class=\"hero-grid\">\n<div>\n<span class=\"eyebrow\">OxygenProxy · 透明代理</span>\n<h1>OxygenProxy · 像氧气一样轻盈的网络代理</h1>\n<p class=\"lead\">OxygenProxy 致力于把复杂的网络代理变得简单透明。我们用清晰的套餐、稳定的节点池和可读的流量账单，让每一次连接都被看见。</p>\n<div class=\"meta\">已为多平台用户提供按月与按年订阅方案</div>\n<div class=\"anchor-nav\" aria-label=\"页面锚点导航\">\n<a href=\"#plans\">查看套餐</a>\n<a href=\"#how\">使用方法</a>\n<a href=\"#clients\">支持客户端</a>\n<a href=\"#faq\">常见问题</a>\n<a href=\"#about\">关于品牌</a>\n</div>\n</div>\n<aside class=\"info-panel\" aria-label=\"服务速览\">\n<h3>服务速览</h3>\n<dl class=\"kv\">\n<dt>订阅方式</dt><dd>按月或按年，套餐内可切换</dd>\n<dt>流量结算</dt><dd>每月 1 日重置，账单可下载</dd>\n<dt>设备并行</dt><dd>依据套餐 3 至 20 台设备</dd>\n<dt>流媒体</dt><dd>原生解锁节点，覆盖常见区域</dd>\n<dt>支持团队</dt><dd>工单系统，专属客户经理可选</dd>\n<dt>试用策略</dt><dd>提供按需评估窗口，详见 FAQ</dd>\n</dl>\n<div class=\"cta-row\">\n<a class=\"btn btn-primary\" href=\"#plans\">选择套餐</a>\n<a class=\"btn btn-ghost\" href=\"#how\">查看使用流程</a>\n</div>\n</aside>\n</div>\n</div>\n</header>\n\n<main>\n\n<section id=\"why\">\n<div class=\"wrap\">\n<span class=\"eyebrow\">为什么选 OxygenProxy</span>\n<h2>把代理这件事，说清楚</h2>\n<p class=\"lead\">市面上的代理服务常让人看不懂：流量去哪了、节点是哪里的、套餐里到底包含什么。OxygenProxy 的做法是把每一项都摊在台面上。</p>\n<div class=\"grid-3\">\n<article class=\"card\">\n<span class=\"tag\">透明度</span>\n<h3>流量可读可查</h3>\n<p>用户面板实时显示已用与剩余流量，按日、按应用拆分账单，月底提供 CSV 导出。</p>\n</article>\n<article class=\"card\">\n<span class=\"tag\">节点策略</span>\n<h3>分层节点池</h3>\n<p>基础节点覆盖日常浏览，高级节点面向流媒体与低延迟游戏，企业节点支持自定义路由。</p>\n</article>\n<article class=\"card\">\n<span class=\"tag\">按需付费</span>\n<h3>灵活的订阅档位</h3>\n<p>三档套餐分别面向轻度用户、重度用户与团队协作，可按月或按年切换，无需长期绑定。</p>\n</article>\n<article class=\"card\">\n<span class=\"tag\">多端并行</span>\n<h3>一台账号，多端使用</h3>\n<p>同一订阅可在电脑、手机、路由器与命令行工具之间并行，按套餐数量上线。</p>\n</article>\n<article class=\"card\">\n<span class=\"tag\">客户支持</span>\n<h3>工单响应可追踪</h3>\n<p>所有问题通过工单提交，每个工单有唯一编号与状态节点，进度可随时回看。</p>\n</article>\n<article class=\"card\">\n<span class=\"tag\">数据边界</span>\n<h3>仅记录必要日志</h3>\n<p>系统仅保留用于故障排查的最短时长运行数据，到期自动清除，原则写进用户协议。</p>\n</article>\n</div>\n</div>\n</section>\n\n<section id=\"plans\">\n<div class=\"wrap\">\n<span class=\"eyebrow\">套餐价格</span>\n<h2>三档阶梯，按用量选择</h2>\n<p class=\"lead\">从每月 100GB 到 1000GB，按需求逐级递进。下方为参考价格，实际费用以下单页面为准。</p>\n<div class=\"plans\">\n\n<article class=\"plan\">\n<h3>基础版</h3>\n<div class=\"sub\">面向个人轻度浏览与偶尔的视频需求</div>\n<div class=\"price\">¥15<small>/月</small></div>\n<span class=\"annual\">按年付仅需 ¥150/年</span>\n<ul>\n<li>每月 100GB 极速流量</li>\n<li>支持 3 台设备同时在线</li>\n<li>解锁基础流媒体</li>\n<li>普通线路节点池</li>\n</ul>\n<a class=\"cta\" href=\"#\">选择基础版</a>\n</article>\n\n<article class=\"plan featured\">\n<span class=\"badge\">推荐</span>\n<h3>旗舰版</h3>\n<div class=\"sub\">面向流媒体、远程协作与游戏加速的重度用户</div>\n<div class=\"price\">¥35<small>/月</small></div>\n<span class=\"annual\">按年付仅需 ¥350/年</span>\n<ul>\n<li>每月 300GB 极速流量</li>\n<li>支持 5 台设备同时在线</li>\n<li>全节点原生流媒体解锁</li>\n<li>IPLC 专线游戏加速优化</li>\n<li>7x24 优先工单支持</li>\n</ul>\n<a class=\"cta\" href=\"#\">选择旗舰版</a>\n</article>\n\n<article class=\"plan\">\n<h3>团队版</h3>\n<div class=\"sub\">面向小团队、设计公司与远程工作室</div>\n<div class=\"price\">¥85<small>/月</small></div>\n<span class=\"annual\">按年付仅需 ¥850/年</span>\n<ul>\n<li>每月 1000GB 极速流量</li>\n<li>支持 20 台设备同时在线</li>\n<li>VIP 专属高带宽节点</li>\n<li>支持企业定制路由</li>\n<li>专属客户经理服务</li>\n</ul>\n<a class=\"cta\" href=\"#\">选择团队版</a>\n</article>\n\n</div>\n<p>所有套餐均支持按月或按年支付，按年方案在页面总价基础上提供整年打包价，可在结算页切换。</p>\n</div>\n</section>\n\n<section id=\"how\">\n<div class=\"wrap\">\n<span class=\"eyebrow\">使用流程</span>\n<h2>四步开始使用 OxygenProxy</h2>\n<p class=\"lead\">从注册到第一次连接，整个过程可以在一杯咖啡的时间里完成。</p>\n<div class=\"steps\">\n<div class=\"step\"><h4>注册账号</h4><p>使用邮箱注册并设置独立密码，建议开启二步验证。</p></div>\n<div class=\"step\"><h4>选择套餐</h4><p>在套餐页挑选适合的档位，按月或按年支付，账单实时可见。</p></div>\n<div class=\"step\"><h4>导入订阅</h4><p>在用户面板复制订阅链接，粘贴到支持的客户端中即可拉取节点。</p></div>\n<div class=\"step\"><h4>连接节点</h4><p>选择延迟最低的节点或场景匹配的节点组，开启连接即可使用。</p></div>\n</div>\n</div>\n</section>\n\n<section id=\"clients\">\n<div class=\"wrap\">\n<span class=\"eyebrow\">支持的客户端</span>\n<h2>在常见平台上导入订阅</h2>\n<p class=\"lead\">OxygenProxy 采用通用订阅协议，可被多数主流客户端识别。下方为常见平台与状态。</p>\n<div class=\"clients\">\n<div class=\"client-row\"><span class=\"plat\">Windows</span><span class=\"note\">桌面通用客户端，支持订阅链接与扫码导入</span><a href=\"#\">获取</a></div>\n<div class=\"client-row\"><span class=\"plat\">macOS</span><span class=\"note\">提供对应桌面客户端与命令行工具</span><a href=\"#\">获取</a></div>\n<div class=\"client-row\"><span class=\"plat\">iOS</span><span class=\"note\">通过系统网络配置导入订阅</span><a href=\"#\">教程</a></div>\n<div class=\"client-row\"><span class=\"plat\">Android</span><span class=\"note\">支持常见代理客户端的订阅格式</span><a href=\"#\">获取</a></div>\n<div class=\"client-row\"><span class=\"plat\">Linux</span><span class=\"note\">命令行与图形客户端均可使用</span><a href=\"#\">文档</a></div>\n<div class=\"client-row\"><span class=\"plat\">路由器</span><span class=\"note\">适用于常见开源固件的全局代理方案</span><span class=\"soon\">配置中</span></div>\n</div>\n</div>\n</section>\n\n<section id=\"faq\">\n<div class=\"wrap\">\n<span class=\"eyebrow\">常见问题</span>\n<h2>分组答疑</h2>\n<p class=\"lead\">按主题整理了订阅、流量、技术与计费四个方向的常见问题。</p>\n\n<div class=\"faq-group\">\n<h3>订阅与套餐</h3>\n<details>\n<summary>基础版、旗舰版、团队版怎么选？</summary>\n<p>基础版适合偶尔浏览与轻度视频，每月 100GB 流量与 3 台设备并行；旗舰版面向重度用户，覆盖原生流媒体与专线游戏加速，5 台设备并行；团队版面向多人协作，20 台设备并行并提供企业级路由与专属客户经理。</p>\n</details>\n<details>\n<summary>套餐可以升降级吗？</summary>\n<p>支持。已生效的订阅可以在用户面板内切换至其他档位，差额按剩余天数折算并在下一结算周期生效。</p>\n</details>\n<details>\n<summary>按月和按年有什么区别？</summary>\n<p>按月方案灵活，可随时取消；按年方案以年付方式结算，单价更低，适合长期使用。两者的功能权益与套餐名称保持一致。</p>\n</details>\n</div>\n\n<div class=\"faq-group\">\n<h3>流量与计费</h3>\n<details>\n<summary>每月流量何时重置？</summary>\n<p>所有套餐的流量在自然月 1 日 00:00 重置。已用与剩余流量在用户面板实时显示，支持按日与按应用维度拆分。</p>\n</details>\n<details>\n<summary>流量用完了会怎样？</summary>\n<p>当月流量耗尽后，连接将被暂停以避免额外费用，不会自动续购。下一周期重置后或用户主动加购流量包后恢复。</p>\n</details>\n<details>\n<summary>是否提供账单导出？</summary>\n<p>支持。每月 3 日之后可在用户面板导出上一周期的账单 CSV，便于团队报销或内部核算。</p>\n</details>\n</div>\n\n<div class=\"faq-group\">\n<h3>技术与连接</h3>\n<details>\n<summary>如何导入订阅链接？</summary>\n<p>登录用户面板后，在「订阅」页面复制对应客户端的订阅链接，粘贴到客户端的订阅地址栏，点击更新即可拉取节点。</p>\n</details>\n<details>\n<summary>支持哪些代理协议？</summary>\n<p>客户端按其能力适配，常见协议包括基于 TLS 的混淆方式与基于 QUIC 的现代传输。具体协议由所选客户端决定，订阅内容与之兼容。</p>\n</details>\n<details>\n<summary>同时连接数怎么算？</summary>\n<p>以账号维度计数，每个独立 IP 地址视为一台设备。同一局域网下多台设备分别计一个连接数。</p>\n</details>\n</div>\n\n<div class=\"faq-group\">\n<h3>退款与支持</h3>\n<details>\n<summary>提供退款吗？</summary>\n<p>首次订阅的 7 天内如未使用超过 2GB 流量，可申请按比例退款。续费周期与已大量使用的订阅不在标准退款范围内，具体以用户协议为准。</p>\n</details>\n<details>\n<summary>工单多久能处理？</summary>\n<p>普通工单在工作日 12 小时内首次响应；旗舰版与团队版用户的工单在工单系统中标记为优先，响应更快。</p>\n</details>\n<details>\n<summary>如何联系客户经理？</summary>\n<p>团队版用户在用户面板可见专属客户经理的联系方式，工作时间内可直接发起沟通。</p>\n</details>\n</div>\n</div>\n</section>\n\n<section id=\"about\">\n<div class=\"wrap\">\n<span class=\"eyebrow\">关于 OxygenProxy</span>\n<h2>一个把透明当作产品的品牌</h2>\n<div class=\"grid-2\">\n<article class=\"card\">\n<h3>我们的态度</h3>\n<p>OxygenProxy 不靠夸张的承诺吸引用户，而是把每一项服务都写成可验证的条目。套餐内容写进合同，节点状态写进面板，账单支持导出。</p>\n</article>\n<article class=\"card\">\n<h3>接下来的方向</h3>\n<p>我们正在完善路由器端的全局代理方案，并扩充团队版的路由定制能力。所有进展会同步更新在用户公告与本页面。</p>\n</article>\n</div>\n</div>\n</section>\n\n</main>\n\n<footer>\n<div class=\"wrap\">\n<div class=\"foot\">\n<div>© OxygenProxy · 一份关于透明代理的长期承诺</div>\n<div>\n<a href=\"#why\">理念</a> · <a href=\"#plans\">套餐</a> · <a href=\"#how\">使用流程</a> · <a href=\"#clients\">客户端</a> · <a href=\"#faq\">常见问题</a>\n</div>\n</div>\n</div>\n</footer>",
